# Optional Firecrawl key. It remains server-side. Without it, public HTML
# pages are fetched directly and blocked sources are reported honestly.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=https://api.firecrawl.dev/v1

# Optional SMTP configuration. The demo defaults to jaferm@aqionlabs.com.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@your-domain.com
SMTP_PASS=your-smtp-password-or-app-password
EMAIL_FROM="AqionVOX <notifications@your-domain.com>"
AQION_NOTIFICATION_EMAIL=jaferm@aqionlabs.com

# Optional server defaults. The builder can receive a key and agent ID for the
# current browser session. Never put a Retell secret in a VITE_ variable.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_API_BASE=https://api.retellai.com

PORT=5173
